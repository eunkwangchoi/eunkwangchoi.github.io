      "type": "object",
      "required": [
        "start",
        "precision"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
